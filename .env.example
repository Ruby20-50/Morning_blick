APP_NAME="Morning Blick"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# OpenAI
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database connection used by the Python application
DATABASE_URL=postgresql://your_domain:morning_blick_app_Pass@localhost:5432/ai_news

# Nylas keys for email integration
NYLAS_API_KEY=your-nylas-api-key
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=your-nylas-client-id


EMAIL=you@example.com


# Public URL Nylas can reach for webhooks (e.g. an ngrok/VS Code tunnel URL)
SERVER_URL=https://your-public-url.example.com
# Secret printed once by `uv run python -m app.scripts.create_webhook`; never commit it
NYLAS_WEBHOOK_SECRET=


# Optional: set to skip the OAuth flow and use one fixed grant
NYLAS_GRANT_ID=

# Base URL of this app; the OAuth redirect URI is APP_BASE_URL + /oauth/exchange
APP_BASE_URL=http://localhost:8000
