APP_NAME="Morning Blick"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# OpenAI
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database connection used by the Python application
DATABASE_URL=postgresql://your_domain:morning_blick_app_Pass@localhost:5432/ai_news

# Nylas keys for email integration
NYLAS_API_KEY=your-nylas-api-key
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=your-nylas-client-id


EMAIL=you@example.com


# Public URL Nylas can reach for webhooks (e.g. an ngrok/VS Code tunnel URL)
SERVER_URL=https://your-public-url.example.com
# Secret printed once by `uv run python -m app.scripts.create_webhook`; never commit it
NYLAS_WEBHOOK_SECRET=


# Optional: set to skip the OAuth flow and use one fixed grant
NYLAS_GRANT_ID=

# Base URL of this app; the OAuth redirect URI is APP_BASE_URL + /oauth/exchange
APP_BASE_URL=http://localhost:8000

# Morning briefing
TIMEZONE=Europe/Berlin
# Timeouts in seconds: per HTTP request, and per provider (all its requests together)
HTTP_TIMEOUT=5
PROVIDER_TIMEOUT=8

# Weather (Open-Meteo); defaults to Berlin
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.41
WEATHER_TIMEZONE=Europe/Berlin

# News (Hacker News): number of top stories shown
HN_STORY_COUNT=5

# Transport (VBB, community API v6.vbb.transport.rest). Find a stop id with
# https://v6.vbb.transport.rest/locations?query=<name>&addresses=false&poi=false
VBB_STOP_ID=900100003
VBB_DURATION_MINUTES=30
VBB_MIN_DELAY_MINUTES=3

# Cache lifetimes in seconds
CACHE_TTL_WEATHER=900
CACHE_TTL_HN=600
# keep >= 60 to stay well below the VBB limit of 100 requests/minute
CACHE_TTL_VBB=60
# today's calendar events (uses NYLAS_API_KEY and NYLAS_GRANT_ID or the signed-in session)
CACHE_TTL_NYLAS=60
